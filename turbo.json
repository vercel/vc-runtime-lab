{
  "$schema": "https://turborepo.org/schema.json",
  "globalPassThroughEnv": ["MFE_DEBUG"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
