{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["MFE_DEBUG", "TURBOPACK"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "HEADER_URL",
        "FOOTER_URL",
        "HOME_URL",
        "BEDS_URL",
        "SALE_URL",
        "PDP_URL",
        "CHECKOUT_URL",
        "VERCEL_URL",
        "VERCEL_ENV",
        "TURBOPACK"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@shop/shell#build": {
      "dependsOn": [
        "@shop/header#build",
        "@shop/footer#build",
        "@shop/home#build",
        "@shop/beds#build",
        "@shop/pdp#build",
        "@shop/checkout#build",
        "@shop/sale#build",
        "^build"
      ],
      "env": [
        "HEADER_URL",
        "FOOTER_URL",
        "HOME_URL",
        "BEDS_URL",
        "SALE_URL",
        "PDP_URL",
        "CHECKOUT_URL",
        "VERCEL_URL",
        "VERCEL_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
